config_version=5

[application]

config/name="Deep Night"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.0", "GL Compatibility")

[display]

window/size/viewport_width=960
window/size/viewport_height=600
window/stretch/mode="canvas_items"

[input]

move_up={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
move_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
move_down={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
move_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":68)]
}

[rendering]

renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.08, 0.11, 0.14, 1)
